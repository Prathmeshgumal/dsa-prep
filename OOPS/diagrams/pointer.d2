vars: { d2-config: { sketch: true; theme-id: 0; pad: 30 } }
classes: {
  cell: { label.near: outside-top-center; grid-columns: 1; grid-gap: 6; style: { stroke: transparent; fill: transparent; font-size: 24 } }
  box: { width: 110; height: 65; style: { font-size: 24; fill: "#FFFFFF" } }
  addr: { shape: text; style: { font-size: 18; font-color: "#666666" } }
}
grid-columns: 2
horizontal-gap: 180

title: |md
  `int a = 5;`  `int *ptr = &a;`
| {shape: text; near: top-center}

ptr: "ptr" {
  class: cell
  box: "602" {class: box; style.fill: "#E3F0FB"}
  addr: "1132" {class: addr}
}
a: "a" {
  class: cell
  box: "5" {class: box; style.fill: "#FFF3C4"}
  addr: "602" {class: addr}
}
ptr.box -> a.box: "points to" {style.stroke-width: 2}

note: |md
  `*ptr` = **value stored at the address stored in ptr** = 5
| {near: bottom-center}
